# Cloud sync (optional). Unset locally — the app runs fine on localStorage
# alone; sync only activates once these are configured in Vercel.
#
# Server-side (Vercel serverless function, api/data.ts):
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SYNC_SECRET=

# Client-side (baked into the Vite bundle at build time — must match
# SYNC_SECRET above exactly, since it's sent as the x-sync-secret header):
VITE_SYNC_SECRET=
